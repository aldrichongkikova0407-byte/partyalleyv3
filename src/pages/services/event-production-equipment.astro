---
import Layout from '../../layouts/Layout.astro';

const description = 'We help with event setup and production. Tell us what you’re planning, where it will take place, and what equipment or setup support you have in mind.';
---

<Layout title="Event Production & Equipment | Party Alley" {description}>
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:pb-32 md:pt-24">
		<h1 class="mx-auto max-w-[850px] text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">Event Production &amp; Equipment for Corporate Functions &amp; Personal Celebrations</h1>
		<p class="mx-auto mt-6 max-w-[600px] text-base leading-relaxed text-stone-600 sm:text-lg">{description}</p>
		<div class="mt-8">
			<span class="inline-block rounded-md bg-[#B93442] px-6 py-3 font-semibold text-white opacity-70">Request a Quote</span>
		</div>
		<p class="mt-3 text-sm text-stone-500">Request a Quote is coming soon.</p>
	</section>
	<section class="bg-[#F5F5F5] px-5 py-16 text-stone-900 sm:px-6 md:py-24">
		<div class="mx-auto max-w-7xl">
			<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">How We Help With Event Production</h2>
			<div class="mt-10 grid gap-6 md:grid-cols-3">
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Plan the Setup Around Your Venue</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Tell us where your event will take place and how you’d like to use the space. We’ll discuss the setup support you need.</p>
				</article>
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Identify the Equipment You Need</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Share what you have in mind for the program so we can discuss which equipment would suit it.</p>
				</article>
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Fit Setup Into Your Schedule</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Let us know when the venue opens and when guests arrive so we can discuss when the setup needs to be ready.</p>
				</article>
			</div>
		</div>
	</section>
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:py-24">
		<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Let’s Plan Your Event Setup</h2>
		<p class="mx-auto mt-6 max-w-[600px] leading-relaxed text-stone-600">Share your event date, venue, and what you have planned for the program. We’ll discuss the setup and equipment support you need.</p>
		<div class="mt-8">
			<span class="inline-block rounded-md bg-[#B93442] px-6 py-3 font-semibold text-white opacity-70">Request a Quote</span>
		</div>
		<p class="mt-3 text-sm text-stone-500">Request a Quote is coming soon.</p>
	</section>
</Layout>
