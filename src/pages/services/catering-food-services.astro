---
import Layout from '../../layouts/Layout.astro';

const description = 'We provide catering and food services for corporate functions and personal celebrations. Tell us what you’re planning and what kind of meal you have in mind for your guests.';
---

<Layout title="Catering & Food Services | Party Alley" {description}>
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:pb-32 md:pt-24">
		<h1 class="mx-auto max-w-[850px] text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">Catering &amp; Food Services for Corporate Functions &amp; Personal Celebrations</h1>
		<p class="mx-auto mt-6 max-w-[600px] text-base leading-relaxed text-stone-600 sm:text-lg">{description}</p>
		<div class="mt-8">
			<span class="inline-block rounded-md bg-[#B93442] px-6 py-3 font-semibold text-white opacity-70">Request a Quote</span>
		</div>
		<p class="mt-3 text-sm text-stone-500">Request a Quote is coming soon.</p>
	</section>
	<section class="bg-[#F5F5F5] px-5 py-16 text-stone-900 sm:px-6 md:py-24">
		<div class="mx-auto max-w-7xl">
			<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">How We Help Plan Food for Your Event</h2>
			<div class="mt-10 grid gap-6 md:grid-cols-3">
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Choose Food That Fits the Occasion</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Tell us what kind of event you’re hosting and what you have in mind for the meal. We’ll discuss what could work for your occasion.</p>
				</article>
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Plan Around Your Guests</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Share your expected guest count and any food preferences you already know about so we can discuss what your group needs.</p>
				</article>
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Fit the Meal Into Your Schedule</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Let us know when you’d like food to be served so we can discuss how it fits into the rest of your event.</p>
				</article>
			</div>
		</div>
	</section>
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:py-24">
		<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Let’s Plan the Food for Your Event</h2>
		<p class="mx-auto mt-6 max-w-[600px] leading-relaxed text-stone-600">Tell us what you’re celebrating or hosting, how many guests you’re expecting, and what you have in mind for the meal.</p>
		<div class="mt-8">
			<span class="inline-block rounded-md bg-[#B93442] px-6 py-3 font-semibold text-white opacity-70">Request a Quote</span>
		</div>
		<p class="mt-3 text-sm text-stone-500">Request a Quote is coming soon.</p>
	</section>
</Layout>
