---
import Layout from '../../layouts/Layout.astro';

const description = 'We help you plan your event, coordinate the details, and manage the program on the day. Tell us what you’re planning and where you’d like support.';
---

<Layout title="Event Planning & Management | Party Alley" {description}>
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:pb-32 md:pt-24">
		<h1 class="mx-auto max-w-[850px] text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">Event Planning &amp; Management for Your Corporate Function or Personal Celebration</h1>
		<p class="mx-auto mt-6 max-w-[600px] text-base leading-relaxed text-stone-600 sm:text-lg">{description}</p>
		<div class="mt-8">
			<span class="inline-block rounded-md bg-[#B93442] px-6 py-3 font-semibold text-white opacity-70">Request a Quote</span>
		</div>
		<p class="mt-3 text-sm text-stone-500">Request a Quote is coming soon.</p>
	</section>
	<section class="bg-[#F5F5F5] px-5 py-16 text-stone-900 sm:px-6 md:py-24">
		<div class="mx-auto max-w-7xl">
			<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">How We Help You Plan Your Event</h2>
			<div class="mt-10 grid gap-6 md:grid-cols-3">
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Know What to Plan First</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We help you identify the decisions and preparations that need your attention first.</p>
				</article>
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Keep the Details Organized</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We help you coordinate the details and keep track of what still needs to be arranged before the event.</p>
				</article>
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Stay Present on the Day</h3>
					<p class="mt-4 leading-relaxed text-stone-600">With someone helping manage the program and coordinate what happens next, you can spend more time with your guests.</p>
				</article>
			</div>
		</div>
	</section>
	<section class="bg-white px-5 py-16 text-stone-900 sm:px-6 md:py-24">
		<div class="mx-auto max-w-3xl">
			<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">What’s Included in Event Planning &amp; Management</h2>
			<ul class="mt-10 space-y-8">
				<li>
					<h3 class="text-xl font-bold">Planning Support</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We help you decide what needs to be planned and what to prioritize.</p>
				</li>
				<li>
					<h3 class="text-xl font-bold">Pre-Event Coordination</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We help you organize the event details and keep track of what still needs to be arranged.</p>
				</li>
				<li>
					<h3 class="text-xl font-bold">Event-Day Program Management</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We help manage the order and timing of the program on the day of your event.</p>
				</li>
			</ul>
		</div>
	</section>
	<section class="bg-[#F5F5F5] px-5 py-16 text-stone-900 sm:px-6 md:py-24">
		<div class="mx-auto max-w-7xl">
			<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">How Event Planning Works</h2>
			<ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
				<li class="rounded-xl bg-white p-6 text-center sm:p-8">
					<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">1</span>
					<h3 class="mt-4 text-xl font-bold">Share Your Event Details</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Tell us about your occasion and the support you're looking for.</p>
				</li>
				<li class="rounded-xl bg-white p-6 text-center sm:p-8">
					<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">2</span>
					<h3 class="mt-4 text-xl font-bold">Review Your Options</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We'll discuss the services that fit your event and priorities.</p>
				</li>
				<li class="rounded-xl bg-white p-6 text-center sm:p-8">
					<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">3</span>
					<h3 class="mt-4 text-xl font-bold">Confirm the Plan</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We'll confirm the services and event details together.</p>
				</li>
				<li class="rounded-xl bg-white p-6 text-center sm:p-8">
					<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">4</span>
					<h3 class="mt-4 text-xl font-bold">Bring Your Event to Life</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We'll provide the event support we agreed on.</p>
				</li>
			</ol>
		</div>
	</section>
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:py-24">
		<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Let’s Start Planning Your Event</h2>
		<p class="mx-auto mt-6 max-w-[600px] leading-relaxed text-stone-600">Tell us what you’re planning and where you’d like help, from the first decisions to managing the program on the day.</p>
		<div class="mt-8">
			<span class="inline-block rounded-md bg-[#B93442] px-6 py-3 font-semibold text-white opacity-70">Request a Quote</span>
		</div>
		<p class="mt-3 text-sm text-stone-500">Request a Quote is coming soon.</p>
	</section>
</Layout>
