---
import Layout from '../../layouts/Layout.astro';
import Link from '../../components/Link.astro';

const description = 'Explore our event services and choose the support you need for your corporate function or personal celebration.';
---

<Layout title="Event Services | Party Alley" {description}>
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:py-24">
		<h1 class="mx-auto max-w-[850px] text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">Find the Support Your Event Needs</h1>
		<p class="mx-auto mt-6 max-w-[600px] text-base leading-relaxed text-stone-600 sm:text-lg">{description}</p>
	</section>
	<section class="bg-white px-5 pb-16 text-stone-900 sm:px-6 md:pb-24">
		<div class="mx-auto max-w-7xl">
			<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">Explore Our Event Services</h2>
			<div class="mt-10 grid gap-6 md:grid-cols-2">
				<article class="rounded-xl bg-[#F5F5F5] p-6 sm:p-8">
					<h3 class="text-xl font-bold">Event Planning &amp; Management</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Support for organizing event preparations, coordinating important details, and managing the program for corporate functions and personal celebrations.</p>
					<div class="mt-4"><Link href="/services/event-planning-management/" label="Explore Event Planning & Management" variant="secondary" /></div>
				</article>
				<article class="rounded-xl bg-[#F5F5F5] p-6 sm:p-8">
					<h3 class="text-xl font-bold">Event Styling &amp; Decoration</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Styling event spaces to bring together your ideas, preferences, and the atmosphere you want to create for your occasion.</p>
					<div class="mt-4"><Link href="/services/event-styling-decoration/" label="Explore Event Styling & Decoration" variant="secondary" /></div>
				</article>
				<article class="rounded-xl bg-[#F5F5F5] p-6 sm:p-8">
					<h3 class="text-xl font-bold">Catering &amp; Food Services</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Food and catering services that complement corporate functions and personal celebrations, bringing guests together over a meal.</p>
					<div class="mt-4"><Link href="/services/catering-food-services/" label="Explore Catering & Food Services" variant="secondary" /></div>
				</article>
				<article class="rounded-xl bg-[#F5F5F5] p-6 sm:p-8">
					<h3 class="text-xl font-bold">Event Production &amp; Equipment</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Support for event setup and production, with equipment suited to the needs of your occasion.</p>
					<div class="mt-4"><Link href="/services/event-production-equipment/" label="Explore Event Production & Equipment" variant="secondary" /></div>
				</article>
			</div>
		</div>
	</section>
</Layout>
