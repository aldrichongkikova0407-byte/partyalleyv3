---
import Layout from '../../layouts/Layout.astro';

const description = 'We style event spaces for corporate functions and personal celebrations. Share your ideas and the atmosphere you want to create, and we’ll help bring them together.';
---

<Layout title="Event Styling & Decoration | Party Alley" {description}>
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:pb-32 md:pt-24">
		<h1 class="mx-auto max-w-[850px] text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">Event Styling &amp; Decoration That Brings Your Vision to Life</h1>
		<p class="mx-auto mt-6 max-w-[600px] text-base leading-relaxed text-stone-600 sm:text-lg">{description}</p>
		<div class="mt-8">
			<span class="inline-block rounded-md bg-[#B93442] px-6 py-3 font-semibold text-white opacity-70">Request a Quote</span>
		</div>
		<p class="mt-3 text-sm text-stone-500">Request a Quote is coming soon.</p>
	</section>
	<section class="bg-[#F5F5F5] px-5 py-16 text-stone-900 sm:px-6 md:py-24">
		<div class="mx-auto max-w-7xl">
			<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">How We Help Style Your Event</h2>
			<div class="mt-10 grid gap-6 md:grid-cols-3">
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Find a Look That Fits Your Event</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We help you turn your ideas and preferences into a clear direction for the décor.</p>
				</article>
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Create the Atmosphere You Want</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We style the space around how you want the occasion to feel for you and your guests.</p>
				</article>
				<article class="rounded-xl bg-white p-6 sm:p-8">
					<h3 class="text-xl font-bold">Bring the Details Together</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We coordinate the decorative details so the space feels cohesive.</p>
				</article>
			</div>
		</div>
	</section>
	<section class="bg-[#F5F5F5] px-5 py-16 text-stone-900 sm:px-6 md:py-24">
		<div class="mx-auto max-w-7xl">
			<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">How Event Styling Works</h2>
			<ol class="mt-10 grid gap-6 md:grid-cols-3">
				<li class="rounded-xl bg-white p-6 text-center sm:p-8">
					<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">1</span>
					<h3 class="mt-4 text-xl font-bold">Share Your Vision</h3>
					<p class="mt-4 leading-relaxed text-stone-600">Tell us about your event, the look you have in mind, and how you want the space to feel.</p>
				</li>
				<li class="rounded-xl bg-white p-6 text-center sm:p-8">
					<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">2</span>
					<h3 class="mt-4 text-xl font-bold">Plan Your Styling</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We’ll work with you to choose a styling direction that fits your occasion and venue.</p>
				</li>
				<li class="rounded-xl bg-white p-6 text-center sm:p-8">
					<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">3</span>
					<h3 class="mt-4 text-xl font-bold">Bring It to Life</h3>
					<p class="mt-4 leading-relaxed text-stone-600">We’ll bring the agreed décor and styling details together for your event.</p>
				</li>
			</ol>
		</div>
	</section>
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:py-24">
		<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Let’s Bring Your Styling Ideas to Life</h2>
		<p class="mx-auto mt-6 max-w-[600px] leading-relaxed text-stone-600">Tell us about your occasion, the look you have in mind, and how you want your guests to feel when they walk in.</p>
		<div class="mt-8">
			<span class="inline-block rounded-md bg-[#B93442] px-6 py-3 font-semibold text-white opacity-70">Request a Quote</span>
		</div>
		<p class="mt-3 text-sm text-stone-500">Request a Quote is coming soon.</p>
	</section>
</Layout>
