---
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
---

<Layout title="Page Not Found | Party Alley" description="This page is unavailable. Return to the Party Alley homepage.">
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:py-24">
		<h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Page Not Found</h1>
		<p class="mx-auto mt-6 max-w-[600px] leading-relaxed text-stone-600">The page you’re looking for isn’t available.</p>
		<div class="mt-8"><Link href="/" label="Back to Home" variant="primary" /></div>
	</section>
</Layout>
