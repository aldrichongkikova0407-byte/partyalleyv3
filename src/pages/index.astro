---
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import { mainNavigation } from '../data/global';

const services = mainNavigation.find((item) => item.label === 'Services')!;
---

<Layout
	title="Party Alley | Event Production and Management in Metro Manila"
	description="Party Alley provides event production and management services for corporate functions and personal celebrations."
>
		<section class="bg-white px-5 pb-16 pt-16 text-center text-stone-900 sm:px-6 md:pb-32 md:pt-24">
			<h1 class="mx-auto max-w-[850px] text-4xl font-bold leading-tight tracking-tight sm:text-5xl lg:text-6xl">
				Bringing Your Events to Life with Full-Service Production &amp; Management
			</h1>
			<p class="mx-auto mt-6 max-w-[600px] text-base leading-relaxed text-stone-600 sm:text-lg">
				From corporate functions to personal celebrations, we bring event services together to help you plan, produce, and manage your occasion.
			</p>
			<div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
				<span class="rounded-md bg-[#B93442] px-6 py-3 font-semibold text-white opacity-70">Request a Quote</span>
				<Link href={services.href} isExternal={services.isExternal} label="Explore Services" variant="secondary" />
			</div>
			<p class="mt-3 text-sm text-stone-500">Request a Quote is coming soon.</p>
		</section>
		<section class="bg-[#F5F5F5] px-5 py-16 text-stone-900 sm:px-6 md:py-24">
			<div class="mx-auto max-w-7xl">
				<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">Why Choose Party Alley</h2>
				<div class="mt-10 grid items-center gap-6 md:grid-cols-[2fr_3fr] md:gap-8">
					<div class="rounded-xl bg-white p-6 text-left sm:p-8">
						<p class="leading-relaxed text-stone-600">Explore different event services through one provider, making it easier to bring the elements of your occasion together.</p>
					</div>
					<div class="flex aspect-video items-center justify-center rounded-xl bg-stone-200 p-6 text-center text-stone-600">
						<p>Party Alley video coming soon.</p>
					</div>
				</div>
			</div>
		</section>
		<section class="bg-white px-5 py-16 text-stone-900 sm:px-6 md:py-24">
			<div class="mx-auto max-w-7xl">
				<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">Services for Your Event</h2>
				<p class="mx-auto mt-6 max-w-[600px] text-center leading-relaxed text-stone-600">Explore the event services Party Alley offers to help you bring your occasion together.</p>
				<div class="mt-10 grid gap-6 md:grid-cols-2">
					<article class="rounded-xl bg-[#F5F5F5] p-6 text-left sm:p-8">
						<h3 class="text-xl font-bold">Event Planning &amp; Management</h3>
						<p class="mt-4 leading-relaxed text-stone-600">Support for organizing event preparations, coordinating important details, and managing the program for corporate functions and personal celebrations.</p>
						<div class="mt-4"><Link href="/services/event-planning-management/" label="Explore Event Planning & Management" variant="secondary" /></div>
					</article>
					<article class="rounded-xl bg-[#F5F5F5] p-6 text-left sm:p-8">
						<h3 class="text-xl font-bold">Event Styling &amp; Decoration</h3>
						<p class="mt-4 leading-relaxed text-stone-600">Styling event spaces to bring together your ideas, preferences, and the atmosphere you want to create for your occasion.</p>
					</article>
					<article class="rounded-xl bg-[#F5F5F5] p-6 text-left sm:p-8">
						<h3 class="text-xl font-bold">Catering &amp; Food Services</h3>
						<p class="mt-4 leading-relaxed text-stone-600">Food and catering services that complement corporate functions and personal celebrations, bringing guests together over a meal.</p>
					</article>
					<article class="rounded-xl bg-[#F5F5F5] p-6 text-left sm:p-8">
						<h3 class="text-xl font-bold">Event Production &amp; Equipment</h3>
						<p class="mt-4 leading-relaxed text-stone-600">Support for event setup and production, with equipment suited to the needs of your occasion.</p>
					</article>
				</div>
			</div>
		</section>
		<section class="bg-[#F5F5F5] px-5 py-16 text-stone-900 sm:px-6 md:py-24">
			<div class="mx-auto max-w-7xl">
				<h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">Our Process</h2>
				<ol class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
					<li class="rounded-xl bg-white p-6 text-center sm:p-8">
						<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">1</span>
						<h3 class="mt-4 text-xl font-bold">Share Your Event Details</h3>
						<p class="mt-4 leading-relaxed text-stone-600">Tell us about your occasion and the support you're looking for.</p>
					</li>
					<li class="rounded-xl bg-white p-6 text-center sm:p-8">
						<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">2</span>
						<h3 class="mt-4 text-xl font-bold">Review Your Options</h3>
						<p class="mt-4 leading-relaxed text-stone-600">We'll discuss the services that fit your event and priorities.</p>
					</li>
					<li class="rounded-xl bg-white p-6 text-center sm:p-8">
						<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">3</span>
						<h3 class="mt-4 text-xl font-bold">Confirm the Plan</h3>
						<p class="mt-4 leading-relaxed text-stone-600">We'll confirm the services and event details together.</p>
					</li>
					<li class="rounded-xl bg-white p-6 text-center sm:p-8">
						<span aria-hidden="true" class="text-2xl font-bold text-[#B93442]">4</span>
						<h3 class="mt-4 text-xl font-bold">Bring Your Event to Life</h3>
						<p class="mt-4 leading-relaxed text-stone-600">We'll provide the event support we agreed on.</p>
					</li>
				</ol>
			</div>
		</section>
		<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:py-24">
			<h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Ready to Work With Us?</h2>
			<p class="mx-auto mt-6 max-w-[600px] leading-relaxed text-stone-600">Tell us about your upcoming occasion and the event services you're looking for. Let's explore how Party Alley can support your plans.</p>
			<div class="mt-8">
				<span class="inline-block rounded-md bg-[#B93442] px-6 py-3 font-semibold text-white opacity-70">Get a Quote</span>
			</div>
			<p class="mt-3 text-sm text-stone-500">This option is coming soon.</p>
		</section>
</Layout>
