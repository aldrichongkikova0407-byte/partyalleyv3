---
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
---

<Layout title="Thank You | Party Alley" description="Thank you for your inquiry to Party Alley.">
	<section class="bg-white px-5 py-16 text-center text-stone-900 sm:px-6 md:py-24">
		<h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Thank You for Your Inquiry</h1>
		<p class="mx-auto mt-6 max-w-[600px] leading-relaxed text-stone-600">We’ve received your event details and will be in touch.</p>
		<div class="mt-8"><Link href="/" label="Back to Home" /></div>
	</section>
</Layout>
